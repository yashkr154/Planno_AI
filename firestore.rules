rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    function isCreatingWithOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Profiles Collection
    match /profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isCreatingWithOwner();
      allow update, delete: if isDocOwner();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isCreatingWithOwner();
      allow update, delete: if isDocOwner();
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isCreatingWithOwner();
      allow update, delete: if isDocOwner();
    }

    // Guests Collection
    match /guests/{guestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isCreatingWithOwner();
      allow update, delete: if isDocOwner();
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
